# ── Supabase (SOURCE — read-only) ────────────────────────────────────────
# The migration reads objects with the SERVICE ROLE key so it can see every
# file regardless of RLS. This key is powerful: keep it local, never commit
# it, never ship it to the browser.
SUPABASE_URL=https://iwqnhajzjudmhseurwmh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__paste_service_role_key_here__

# ── Cloudflare R2 (DESTINATION) ──────────────────────────────────────────
# Create an R2 API token (Account → R2 → Manage API Tokens) with
# Object Read & Write on the target bucket. The endpoint is your account's
# S3 API endpoint (Account → R2 → Settings → S3 API).
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=__paste_r2_access_key_id__
R2_SECRET_ACCESS_KEY=__paste_r2_secret_access_key__

# The R2 bucket name. Keep it identical to the Supabase bucket ("patient-files")
# so object keys map 1:1.
R2_BUCKET=patient-files
