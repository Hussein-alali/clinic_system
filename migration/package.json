{
  "name": "clinksys-r2-migration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Non-destructive COPY migration of Supabase Storage objects to Cloudflare R2 for the Kinetic clinic system. Standalone tooling — not part of the deployed app runtime.",
  "engines": { "node": ">=18" },
  "scripts": {
    "migrate:dry": "node migrate.mjs --dry-run",
    "migrate": "node migrate.mjs",
    "verify": "node verify.mjs",
    "verify:checksum": "node verify.mjs --checksum",
    "test": "node --test ../tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@supabase/supabase-js": "^2.45.0"
  }
}
